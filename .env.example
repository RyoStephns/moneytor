PORT=3000
NODE_ENV=production

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=moneytor
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=moneytor

DEFAULT_CURRENCY=IDR

# The public HTTPS address people and AI assistants reach. OAuth metadata, the MCP
# resource (<this>/mcp) and every redirect are built from it, so it must match exactly.
PUBLIC_BASE_URL=https://moneytor.example.com

# One-time token for claiming the owner account at /setup. Generate a long random
# value (e.g. `openssl rand -base64 32`), claim the owner, then you may remove it:
# without it the setup page is switched off.
SETUP_TOKEN=

# Trust the reverse proxy for the client IP (login rate limits use it).
# true = only a proxy on this machine (default); false = none; or a hop count / subnet.
# TRUST_PROXY=true

# Optional app-level IP allowlist for /mcp. Claude connects from 160.79.104.0/21.
# Google doesn't publish Gemini's addresses, so turning this on blocks Gemini.
# ALLOWED_CIDRS=160.79.104.0/21,127.0.0.1/32
